InpUseStepTrail=true
InpStep1TrigR=1.0
InpStep1LockR=0.1
InpStep2TrigR=1.5
InpStep2LockR=0.7
InpStep3TrigR=2.0
InpStep3LockR=1.3
InpUseTrailing=true
