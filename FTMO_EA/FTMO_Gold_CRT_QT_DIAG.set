InpDailyLossStopPct=4.0
InpMaxDDStopPct=8.0
InpMaxSpreadPoints=80
InpMaxTradesPerDay=8
InpESTOffsetHours=7
InpAllowQ1=false
InpAllowQ2=true
InpAllowQ3=true
InpAllowQ4=true
InpUseTrueOpenBias=false
InpSkipFriday=false
InpRangeTF=16385
